;; goal_src/user/goal-tempo.gc

;; 1. Define our custom process type
(deftype tempo-process (process)
  ()
  )

;; Global variables to track state
(define *tempo-process* (the-as handle #f))
(define *tempo-bpm* 120)
(define *tempo-beats-per-measure* 3) ;; 3 beats: Punch (1) -> Roll (2) -> Jump (3)

;; Timestamp registers (300Hz ticks)
(define *punch-time* 0)
(define *roll-time* 0)
(define *jump-time* 0)

;; Physical input frame offsets (relative to the start of the previous state)
(define *l1-physical-press-frame* 0)
(define *x-physical-press-frame* 0)

;; State-machine evaluation registers
(define *punch-to-roll-frames* 0)
(define *roll-to-jump-frames* 0)
(define *had-running-attack* #f)
(define *had-wheel* #f)
(define *had-flip* #f)
(define *had-uppercut* #f)
(define *had-punch-jump* #f)

;; 2. Dynamic button-hold helper function
(defun cpad-hold-by-symbol? ((pad int) (btn symbol))
  (cond
    ((= btn 'x) (cpad-hold? pad x))
    ((= btn 'circle) (cpad-hold? pad circle))
    ((= btn 'square) (cpad-hold? pad square))
    ((= btn 'triangle) (cpad-hold? pad triangle))
    ((= btn 'l1) (cpad-hold? pad l1))
    ((= btn 'r1) (cpad-hold? pad r1))
    ((= btn 'l2) (cpad-hold? pad l2))
    ((= btn 'r2) (cpad-hold? pad r2))
    ((= btn 'up) (cpad-hold? pad up))
    ((= btn 'down) (cpad-hold? pad down))
    ((= btn 'left) (cpad-hold? pad left))
    ((= btn 'right) (cpad-hold? pad right))
    (else #f)
    )
  )

;; 3. Define the idle state containing our real-time frame loop
(defstate tempo-idle (tempo-process)
  :code (lambda ()
          (let ((last-beat-idx -1)
                (last-state 'none)
                (square-was-held #f)
                (l1-was-held #f)
                (x-was-held #f)
                )
            (loop
              ;; Calculate ticks per beat (300 ticks/sec * 60 sec = 18000 ticks/min)
              (let* ((ticks-per-beat (/ 18000 *tempo-bpm*))
                     (current-ticks (the int (current-time)))
                     (beat-idx (/ current-ticks ticks-per-beat))
                     (tick-in-beat (mod current-ticks ticks-per-beat))
                     (measure-beat (mod beat-idx *tempo-beats-per-measure*))
                     )
                
                ;; --- 1. TRACK PHYSICAL BUTTON TAPS (RISING EDGES) ---
                (cond
                  ((cpad-hold? 0 l1)
                   (when (and (not l1-was-held) (> *punch-time* 0) (= *roll-time* 0))
                     ;; Log how many frames after the punch you physically pressed L1
                     (set! *l1-physical-press-frame* (/ (- current-ticks *punch-time*) 5))
                     )
                   (set! l1-was-held #t)
                   )
                  (else
                   (set! l1-was-held #f)
                   )
                  )
                
                (cond
                  ((cpad-hold? 0 x)
                   (when (and (not x-was-held) (> *roll-time* 0) (= *jump-time* 0))
                     ;; Log how many frames after the roll you physically pressed X
                     (set! *x-physical-press-frame* (/ (- current-ticks *roll-time*) 5))
                     )
                   (set! x-was-held #t)
                   )
                  (else
                   (set! x-was-held #f)
                   )
                  )

                ;; --- 2. INTERCEPT ENGINE STATE MACHINE TRANSITIONS ---
                (when *target*
                  (let ((s (-> *target* state name)))
                    (cond
                      ;; A. Jak starts Punch Lunge
                      ((and (= s 'target-running-attack) (!= last-state 'target-running-attack))
                       (set! *punch-time* current-ticks)
                       (set! *roll-time* 0)
                       (set! *jump-time* 0)
                       (set! *l1-physical-press-frame* 0)
                       (set! *x-physical-press-frame* 0)
                       (set! *punch-to-roll-frames* 0)
                       (set! *roll-to-jump-frames* 0)
                       (set! *had-running-attack* #t)
                       (set! *had-wheel* #f)
                       (set! *had-flip* #f)
                       (set! *had-uppercut* #f)
                       (set! *had-punch-jump* #f)
                       )
                      
                      ;; B. Jak successfully transitions to Roll
                      ((and (= s 'target-wheel) (!= last-state 'target-wheel))
                       (set! *roll-time* current-ticks)
                       (set! *punch-to-roll-frames* (/ (- *roll-time* *punch-time*) 5))
                       (set! *had-wheel* #t)
                       )
                      
                      ;; C. Jak successfully transitions to Roll Jump
                      ((and (= s 'target-flip) (!= last-state 'target-flip))
                       (set! *jump-time* current-ticks)
                       (set! *roll-to-jump-frames* (/ (- *jump-time* *roll-time*) 5))
                       (set! *had-flip* #t)
                       )
                      
                      ;; D. Error State: Accidental Uppercut
                      ((and (or (= s 'target-attack-uppercut) (= s 'target-attack-uppercut-jump)) 
                            (!= last-state s))
                       (set! *had-uppercut* #t)
                       )
                      
                      ;; E. Error State: Punch Jump (Skipped Roll)
                      ((and (or (= s 'target-jump) (= s 'target-jump-forward)) 
                            (= last-state 'target-running-attack))
                       (set! *had-punch-jump* #t)
                       )
                      )
                    (set! last-state s)
                    )
                  )

                ;; --- 3. DRAW DYNAMIC DIAGNOSTIC INTERFACE ---
                ;; Colors: ~3L = Red, ~5L = Yellow, ~6L = Green, ~0L = Default
                (format *stdcon* "========================================~% ")
                (format *stdcon* "      SPEEDRUN PUNCH-ROLL-JUMP COACH     ~% ")
                (format *stdcon* "========================================~% ")
                (if *target*
                    (format *stdcon* " Jak Live Physics State: ~A~% " (-> *target* state name))
                    (format *stdcon* " Jak Live Physics State: OFFLINE~% ")
                    )
                (format *stdcon* "----------------------------------------~% ")
                
                ;; STAGE 1: PUNCH TO ROLL LUNGE CANCEL
                (cond
                  ((= *punch-time* 0)
                   (format *stdcon* "Punch -> Roll: ~5LWAITING FOR PUNCH [Square]~0L~% ")
                   )
                  ((= *roll-time* 0)
                   (format *stdcon* "Punch -> Roll: ~5LSLIDING (Tap L1)...~0L~% ")
                   (if (> *l1-physical-press-frame* 0)
                       (format *stdcon* "  Physical L1 Tap: Frame ~D (~3LEATEN - Too fast!~0L)~% " 
                               *l1-physical-press-frame*)
                       )
                   )
                  (else
                   (if (and (>= *punch-to-roll-frames* 8) (<= *punch-to-roll-frames* 15))
                       (format *stdcon* "Punch -> Roll: ~6LSUCCESS~0L (Canceled at Frame ~D)~% " 
                               *punch-to-roll-frames*)
                       (format *stdcon* "Punch -> Roll: ~3LSLOPPY~0L (Canceled at Frame ~D)~% " 
                               *punch-to-roll-frames*)
                       )
                   )
                  )
                
                ;; STAGE 2: ROLL TO FLIP JUMP CANCEL
                (cond
                  ((= *roll-time* 0)
                   (format *stdcon* "Roll  -> Jump: WAITING FOR VALID ROLL~% ")
                   )
                  ((= *jump-time* 0)
                   (format *stdcon* "Roll  -> Jump: ~5LROLLING (Tap X)!~0L~% ")
                   (if (> *x-physical-press-frame* 0)
                       (format *stdcon* "  Physical X Tap:  Frame ~D~% " *x-physical-press-frame*)
                       )
                   )
                  (else
                   (if (and (>= *roll-to-jump-frames* 1) (<= *roll-to-jump-frames* 5))
                       (format *stdcon* "Roll  -> Jump: ~6LFLAWLESS FLIP~0L (Canceled at Frame ~D)~% " 
                               *roll-to-jump-frames*)
                       (format *stdcon* "Roll  -> Jump: ~5LSLOW FLIP~0L (Canceled at Frame ~D)~% " 
                               *roll-to-jump-frames*)
                       )
                   )
                  )
                
                ;; --- 4. REAL-TIME CALIBRATION FEEDBACK ---
                (format *stdcon* "----------------------------------------~% ")
                (cond
                  (*had-uppercut*
                   (format *stdcon* "~3LUPPERCUT DETECTED!~0L~% ")
                   (format *stdcon* "Feedback: You held L1 *before* punching.~% ")
                   (format *stdcon* "Fix: Tap Square FIRST, then slide to L1.~% ")
                   )
                  (*had-punch-jump*
                   (format *stdcon* "~3LPUNCH JUMP DETECTED!~0L~% ")
                   (format *stdcon* "Feedback: You jumped directly from the punch.~% ")
                   (format *stdcon* "Fix: Your L1 lunge cancel was skipped or eaten.~% ")
                   )
                  ((and (> *punch-time* 0) (= *roll-time* 0) (> *l1-physical-press-frame* 0))
                   (format *stdcon* "~3LINPUT WAS EATEN!~0L~% ")
                   (format *stdcon* "Feedback: Physical L1 was tapped on Frame ~D.~% " *l1-physical-press-frame*)
                   (format *stdcon* "Fix: Frame 0-7 is locked out. Wait until Frame 8-15.~% ")
                   )
                  (*had-flip*
                   (format *stdcon* "~6LEXTENDED ROLL JUMP REGISTERED!~0L~% ")
                   (format *stdcon* "Excellent execution. Record this feeling!~% ")
                   )
                  )
                (format *stdcon* "========================================~% ")
                
                ;; --- 5. AUDIBLE RHYTHM METRONOME (450 BPM) ---
                ;; 450 BPM maps perfectly to the timing profile of a physical slide-tap!
                (when (!= beat-idx last-beat-idx)
                  (set! last-beat-idx beat-idx)
                  (cond
                    ((= measure-beat 0)
                     ;; Beat 1: High-pitched lunge cue (Press Square)
                     (sound-play-by-name (static-sound-name "money-pickup") (new-sound-id) 1024 1000 0 (the sound-group 1) #t)
                     )
                    ((= measure-beat 1)
                     ;; Beat 2: Mid-pitched roll cue (Press L1)
                     (sound-play-by-name (static-sound-name "money-pickup") (new-sound-id) 1024 200 0 (the sound-group 1) #t)
                     )
                    ((= measure-beat 2)
                     ;; Beat 3: Low-pitched jump cue (Press X)
                     (sound-play-by-name (static-sound-name "money-pickup") (new-sound-id) 1024 -600 0 (the sound-group 1) #t)
                     )
                    )
                  )
                )
              
              ;; Suspend execution until the next frame
              (suspend)
              )
            )
          )
  )

;; 4. Helper functions to safely start and stop the process
(defun tempo-stop ()
  (kill-by-type tempo-process *active-pool*)
  (set! *tempo-process* (the-as handle #f))
  (format #t "GOAL-Tempo background process stopped cleanly and screen cleared.~%")
  (none)
  )

(defun tempo-start ()
  (tempo-stop)
  ;; Reset states on start
  (set! *punch-time* 0)
  (set! *roll-time* 0)
  (set! *jump-time* 0)
  (set! *l1-physical-press-frame* 0)
  (set! *x-physical-press-frame* 0)
  (set! *punch-to-roll-frames* 0)
  (set! *roll-to-jump-frames* 0)
  (set! *had-running-attack* #f)
  (set! *had-wheel* #f)
  (set! *had-flip* #f)
  (set! *had-uppercut* #f)
  (set! *had-punch-jump* #f)
  (let ((proc (get-process *nk-dead-pool* tempo-process 1024)))
    (when proc
      (activate proc *active-pool* 'tempo *kernel-dram-stack*)
      (run-now-in-process proc (lambda () (go tempo-idle)))
      (set! *tempo-process* (process->handle proc))
      (format #t "GOAL-Tempo background process started!~%")
      )
    )
  (none)
  )

; Action Buttons: x, circle, square, triangle
; Shoulder Buttons: l1, r1, l2, r2
; Directions: up, down, left, right
